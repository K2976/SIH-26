<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only: permits cleartext HTTP to the emulator's host-loopback
  alias so BuildConfig.BASE_URL can point at a local Django server
  without HTTPS. Not merged into release builds.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
